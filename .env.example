# Used only for `docker compose up`. Copy this file to `.env` in this same directory:
#   cp .env.example .env
# then fill in the real values. docker-compose.yml passes this file straight through to the
# backend container via `env_file:` — whatever you set here becomes the backend's actual config.
#
# (This is separate from `backend/.env`, which is what the backend reads when running locally
# without Docker — see backend/.env.example for that one.)

# Required. The backend has an insecure built-in default and will happily start without this —
# always set it to a long random value for anything beyond local throwaway testing.
SESSION_SECRET_KEY=

# Required. OIDC provider settings — same meaning as in backend/.env.example. Login will not
# work until these are set (the backend falls back to an empty issuer, which fails at login time
# rather than at startup).
OIDC_ISSUER=https://your-provider.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional — only needed if you're not running the default docker-compose.yml as-is (e.g. a
# different host/port/domain, or behind a reverse proxy). Uncomment and adjust if so; otherwise
# the backend's built-in defaults already match the compose file above.
# FRONTEND_URL=http://localhost:5173
# OIDC_REDIRECT_URI=http://localhost:8010/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
