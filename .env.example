# Used only for `docker compose up`. Copy this file to `.env` in this same directory:
#   cp .env.example .env
# then fill in the real values. docker-compose.yml passes this file straight through to the
# backend container via `env_file:` — whatever you set here becomes the backend's actual config.
#
# (This is separate from `backend/.env`, which is what the backend reads when running locally
# without Docker — see backend/.env.example for that one.)

# Required. The backend has an insecure built-in default and will happily start without this —
# always set it to a long random value for anything beyond local throwaway testing.
SESSION_SECRET_KEY=

# Required. OIDC provider settings — same meaning as in backend/.env.example. Login will not
# work until these are set (the backend falls back to an empty issuer, which fails at login time
# rather than at startup).
OIDC_ISSUER=https://your-provider.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# FRONTEND_URL / OIDC_REDIRECT_URI default to localhost, matching the compose file's example
# ports (5173/8010) — fine for a purely local test, but WRONG the moment you deploy behind a
# real domain or reverse proxy, which is the normal case for anything beyond your own machine.
#
# The frontend container's nginx proxies /api/ straight through to the backend container
# internally (see frontend/nginx.conf) — so there is only ONE public URL for the whole app: the
# domain your reverse proxy points at the frontend container. The backend is never reached
# directly from outside, so it doesn't need its own domain, and its published port in
# docker-compose.yml doesn't matter for this at all.
#
# If you're running this on a real domain, uncomment BOTH lines below and set them to that one
# public domain (FRONTEND_URL bare, OIDC_REDIRECT_URI with the callback path appended) — e.g.
# FRONTEND_URL=https://chronodemica.example.com
# OIDC_REDIRECT_URI=https://chronodemica.example.com/api/auth/oidc/callback
#
# Whatever you set OIDC_REDIRECT_URI to must then be registered — character for character,
# including https:// and the exact path — as the allowed redirect URI for this client at your
# OIDC provider. A mismatch here is exactly what produces a
# "redirect_uri ... is not registered for this client" error at login.
# FRONTEND_URL=http://localhost:5173
# OIDC_REDIRECT_URI=http://localhost:8010/api/auth/oidc/callback
# OIDC_SCOPES=openid profile email
