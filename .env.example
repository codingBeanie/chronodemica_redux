# Used only for `docker compose up` — docker compose automatically reads a `.env` file
# next to docker-compose.yml and substitutes these into the `${VAR:?...}` placeholders there.
# Copy this file to `.env` in this same directory and fill in the real values:
#   cp .env.example .env
#
# (This is separate from `backend/.env`, which is what the backend itself reads when
# running locally without Docker — see backend/.env.example for that one.)

# A long random value, used only to sign the short-lived OIDC login-handshake cookie.
SESSION_SECRET_KEY=

# OIDC provider settings — same meaning as in backend/.env.example. OIDC_REDIRECT_URI
# is fixed to http://localhost:8010/api/auth/oidc/callback directly in docker-compose.yml;
# adjust that line there too if you deploy under a different host/port.
OIDC_ISSUER=https://your-provider.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
