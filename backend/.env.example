APP_NAME=Chronodemica
DATABASE_URL=sqlite:///./data/chronodemica.db
CORS_ORIGINS=["http://localhost:5180"]

# Where the SPA is served — the OIDC callback redirects here with the app's
# own bearer token in the URL fragment once login succeeds.
FRONTEND_URL=http://localhost:5180

# Signs the short-lived session cookie used only during the OIDC login
# handshake (state/nonce CSRF protection). Set this to a long random value.
SESSION_SECRET_KEY=change-me-to-a-long-random-value

# Skips OIDC/login entirely for local development — the frontend's dev build
# (import.meta.env.DEV, never true in the built Docker image) logs straight in as a
# fixed local user, no provider needed. Leave this at "true" unless you're
# specifically testing the real OIDC flow locally. NEVER set this in production —
# the Docker/prod path reads a separate root-level .env that doesn't have this
# variable at all, so it's False there regardless of this file.
AUTH_DISABLED=true

# OIDC provider settings — only needed if AUTH_DISABLED is false (e.g. to test the
# real login flow locally) or when deploying to production. Login is exclusively via
# OIDC — the first person to ever complete a login becomes the (permanent, sole)
# admin. OIDC_ISSUER must serve `<issuer>/.well-known/openid-configuration`, and
# OIDC_REDIRECT_URI must be registered exactly as-is with the provider as an allowed
# redirect URI.
#
# OIDC_REDIRECT_URI schema: <backend-url>/api/auth/oidc/callback
# This is the value to enter as the "redirect URI" / "callback URL" at your
# OIDC provider — it always points at the BACKEND (not the frontend), and
# must match character-for-character (scheme, host, port, path), e.g.:
#   http://localhost:8010/api/auth/oidc/callback              (local dev)
#   https://chronodemica.example.com/api/auth/oidc/callback   (production)
OIDC_ISSUER=https://your-provider.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8010/api/auth/oidc/callback
OIDC_SCOPES=openid profile email
